<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bluetask.Views.StabilityCenterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:Bluetask.ViewModels"
    xmlns:models="using:Bluetask.Models"
    xmlns:converters="using:Bluetask.Services.Converters"
    mc:Ignorable="d"
    Background="{StaticResource App.GradientBackground}"
    RequestedTheme="Dark">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <converters:BoolToAnalyzingTextConverter x:Key="AnalyzingTextConverter"/>
		<!-- Compact checkbox style to conserve horizontal space -->
		<Style x:Key="CompactCheckBox" TargetType="CheckBox">
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Margin" Value="2,0,8,0"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
        <!-- Pretty green gradient for Analyze button (base) -->
        <LinearGradientBrush x:Key="AnalyzeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2CCB7D" Offset="0"/>
            <GradientStop Color="#22B36D" Offset="0.55"/>
            <GradientStop Color="#19965A" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="AnalyzeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="12,12,12,12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#157C4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="ScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="RootBorder" CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Border.Background>
                                    <LinearGradientBrush x:Name="AnalyzeLocalBrush" StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="GS1" Color="#2CCB7D" Offset="0"/>
                                        <GradientStop x:Name="GS2" Color="#22B36D" Offset="0.55"/>
                                        <GradientStop x:Name="GS3" Color="#19965A" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter
                                x:Name="ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{TemplateBinding Foreground}"
                                Margin="{TemplateBinding Padding}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="GS1" Storyboard.TargetProperty="Color" To="#3AD990" Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="GS2" Storyboard.TargetProperty="Color" To="#2CCB7D" Duration="0:0:0.25"/>
                                            <ColorAnimation Storyboard.TargetName="GS3" Storyboard.TargetProperty="Color" To="#22B36D" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="GS1" Storyboard.TargetProperty="Offset" To="0.06" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="GS3" Storyboard.TargetProperty="Offset" To="0.94" Duration="0:0:0.25"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="GS1" Storyboard.TargetProperty="Color" To="#22B36D" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="GS2" Storyboard.TargetProperty="Color" To="#19965A" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="GS3" Storyboard.TargetProperty="Color" To="#147A49" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX" To="0.99" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY" To="0.99" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Meta text styles for consistent alignment -->
        <Style x:Key="MetaCaption" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="MetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
        </Style>
		<DataTemplate x:Key="EventRowTemplate" x:DataType="models:SystemEventItem">
            <Grid Padding="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="10" Height="10" Fill="{x:Bind SeverityBrush, Mode=OneWay}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                        <TextBlock Text="{x:Bind ProviderName, Mode=OneWay}"/>
                        <TextBlock Text="•"/>
                        <TextBlock Text="{x:Bind LogName, Mode=OneWay}"/>
                        <TextBlock Text="•"/>
                        <TextBlock Text="{x:Bind EventId, Mode=OneWay}"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{x:Bind RelativeTime, Mode=OneWay}" HorizontalAlignment="Right"/>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,16">
            <TextBlock Text="Stability Center" FontSize="20" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Tab Navigation -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <Button x:Name="EventsTabButton" 
                    Content="Event Analysis" 
                    Padding="16,8"
                    Background="#2A2F3E"
                    BorderBrush="#3A4150"
                    BorderThickness="1"
                    CornerRadius="6"
                    Click="EventsTab_Click"/>
            <Button x:Name="DisplayRecoveryTabButton" 
                    Content="System Health" 
                    Padding="16,8"
                    Background="#1A1F2E"
                    BorderBrush="#2A2F3E"
                    BorderThickness="1"
                    CornerRadius="6"
                    Click="DisplayRecoveryTab_Click"/>
        </StackPanel>

        <!-- Summary cards (Only visible for Event Analysis tab) -->
        <Grid x:Name="SummaryCards" Grid.Row="2" ColumnSpacing="12" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Crashes Card -->
            <Border Grid.Column="0" Background="{StaticResource App.CardGradientBrush}" BorderBrush="{StaticResource App.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" Foreground="#FF5C5C"/>
                        <TextBlock Text="Crashes" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.CountCrashes, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{StaticResource App.CardGradientBrush}" BorderBrush="{StaticResource App.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB90;" Foreground="#F44336"/>
                        <TextBlock Text="Critical" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.CountCritical, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource App.CardGradientBrush}" BorderBrush="{StaticResource App.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BA;" Foreground="#F0B030"/>
                        <TextBlock Text="Warnings" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.CountWarnings, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{StaticResource App.CardGradientBrush}" BorderBrush="{StaticResource App.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" Foreground="#66CCFF"/>
                        <TextBlock Text="Info" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.CountInfo, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main Content Container -->
        <Grid x:Name="ContentContainer" Grid.Row="3">
            <!-- Events Tab Content -->
            <Grid x:Name="EventsTabContent" Visibility="Visible" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource App.CardGradientBrush}" BorderBrush="{StaticResource App.CardBorder}" BorderThickness="1" CornerRadius="10">
                <Grid>
                    <!-- Event List View (default) -->
                    <Grid x:Name="EventListView" Visibility="{x:Bind ViewModel.ShowAnalysisView, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filters header -->
                        <Grid Grid.Row="0" Padding="10" Background="{StaticResource App.CardHeaderBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="Search message, app, or log" Margin="0,0,10,0" MinWidth="240" TextChanged="SearchBox_TextChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="8,0,0,0">
                                <CheckBox Content="Crashes" Style="{StaticResource CompactCheckBox}" IsChecked="{x:Bind ViewModel.ShowCrashes, Mode=TwoWay}"/>
                                <CheckBox Content="Critical" Style="{StaticResource CompactCheckBox}" IsChecked="{x:Bind ViewModel.ShowCritical, Mode=TwoWay}"/>
                                <CheckBox Content="Warning" Style="{StaticResource CompactCheckBox}" IsChecked="{x:Bind ViewModel.ShowWarnings, Mode=TwoWay}"/>
                                <CheckBox Content="Info" Style="{StaticResource CompactCheckBox}" IsChecked="{x:Bind ViewModel.ShowInfo, Mode=TwoWay}"/>
                                <Button Content="Refresh" Padding="8,3,8,3" Click="Refresh_Click"/>
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="EventsList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.VisibleEvents, Mode=OneWay}" SelectionMode="Single" ItemTemplate="{StaticResource EventRowTemplate}" SelectionChanged="EventsList_SelectionChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#2A2C36"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>

                    <!-- Analysis View (replaces list) -->
                    <Grid x:Name="AnalysisView" Visibility="{x:Bind ViewModel.ShowAnalysisView, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Analysis Header with Close Button -->
                        <Grid Grid.Row="0" Padding="14" Background="{StaticResource App.CardHeaderBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Root Cause Analysis" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.CurrentAnalysis.EventTitle, Mode=OneWay}" Opacity="0.7" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕ Close" Padding="10,6" Click="CloseAnalysis_Click" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Analysis Content ScrollViewer -->
                        <ScrollViewer Grid.Row="1" Padding="16" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" x:Name="AnalysisContent">
                                <!-- Error Message if analysis failed -->
                                <Border Background="#2A1F1F" BorderBrush="#FF5C5C" BorderThickness="2" CornerRadius="8" Padding="14" Visibility="{x:Bind ViewModel.CurrentAnalysis.ErrorMessage, Mode=OneWay, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="❌ Analysis Failed" FontWeight="SemiBold" Foreground="#FF5C5C" FontSize="15"/>
                                        <TextBlock Text="{x:Bind ViewModel.CurrentAnalysis.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" Opacity="0.9"/>
                                    </StackPanel>
                                </Border>

                                <!-- Summary Card (Purple accent) -->
                                <Border Background="#1C1F2E" BorderBrush="#4A5568" BorderThickness="1" CornerRadius="10" Padding="16" x:Name="SummaryCard">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Background="#6B46C1" Width="4" CornerRadius="2" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="Summary" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                        </Grid>
                                        <!-- Content added dynamically in code-behind -->
                                    </StackPanel>
                                </Border>

                                <!-- Root Cause Card -->
                                <Border Background="#1C1F2E" BorderBrush="#4A5568" BorderThickness="1" CornerRadius="10" Padding="16" x:Name="RootCauseCard" Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" Foreground="#F59E0B" FontSize="18" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="Root Cause" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                        </Grid>
                                        <!-- Content added dynamically in code-behind -->
                                    </StackPanel>
                                </Border>

                                <!-- Suggested Fixes Card (Green highlight) -->
                                <Border Background="#0F2820" BorderBrush="#10B981" BorderThickness="2" CornerRadius="10" Padding="16" x:Name="FixesCard" Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="&#xE90F;" Foreground="#10B981" FontSize="18" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="Suggested Fixes" FontSize="17" FontWeight="SemiBold" Foreground="#10B981"/>
                                        </Grid>
                                        <!-- Content added dynamically in code-behind -->
                                    </StackPanel>
                                </Border>

                                <!-- Forum Research Card -->
                                <Border Background="#1C1F2E" BorderBrush="#4A5568" BorderThickness="1" CornerRadius="10" Padding="16" x:Name="ForumCard" Visibility="Collapsed">
                                    <StackPanel Spacing="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="&#xE8F1;" Foreground="#8B5CF6" FontSize="18" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1" Text="Community Research" FontSize="16" FontWeight="SemiBold" Foreground="#E0E0E0"/>
                                        </Grid>
                                        <!-- Content added dynamically in code-behind -->
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="{StaticResource App.CardGradientBrush}" BorderBrush="{StaticResource App.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel Spacing="8">
                    <!-- Header: title + time on same row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Event Details" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding SelectedEvent.RelativeTime}" Opacity="0.7"/>
                    </Grid>

                    <!-- Event title (smaller) -->
                    <StackPanel x:Name="SummaryContainer">
                     <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                         <TextBlock Text="{Binding SelectedEvent.DisplayTitle}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Grid>

                    <!-- Metadata two-column -->
                    <Grid ColumnSpacing="24" RowSpacing="6" Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
                            <TextBlock Text="Event ID" Style="{StaticResource MetaCaption}"/>
                            <TextBlock Text="{Binding SelectedEvent.EventId}" Style="{StaticResource MetaValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2">
                            <TextBlock Text="Category" Style="{StaticResource MetaCaption}"/>
                            <TextBlock Text="{Binding SelectedEvent.CategoryDisplay}" Style="{StaticResource MetaValue}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="0" Grid.Row="1" Spacing="2">
                            <TextBlock Text="Source" Style="{StaticResource MetaCaption}"/>
                            <TextBlock Text="{Binding SelectedEvent.ProviderName}" Style="{StaticResource MetaValue}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                            <TextBlock Text="Reason" Style="{StaticResource MetaCaption}"/>
                            <TextBlock Text="{Binding SelectedEvent.ReasonDisplay}" Style="{StaticResource MetaValue}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>

                    <!-- Key facts (separate lines with increased spacing) -->
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding SelectedEvent.AppName, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE770;" Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedEvent.AppName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding SelectedEvent.ModuleName, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedEvent.ModuleName}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" FontSize="13"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding SelectedEvent.ExceptionCode, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7BA;" Opacity="0.7"/>
                            <TextBlock Text="{Binding SelectedEvent.ExceptionCode}" TextWrapping="Wrap" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>

                    <!-- Keep View Raw visible even when raw expands: place above raw container -->
                    <Button x:Name="ToggleRawButton" Content="View raw" Padding="8,6,8,6" Click="ToggleRaw_Click" HorizontalAlignment="Stretch"/>

                    <!-- Raw details fills the content area when toggled (below the toggle so it pushes content down) -->
                    <Border x:Name="RawContainer" Background="#151A24" BorderBrush="#2A2C36" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,6,0,0" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                            <TextBlock Text="{Binding SelectedEvent.Message}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Analyze button below raw container so it shifts down when raw opens -->
                    <Button x:Name="AnalyzeButton" Style="{StaticResource AnalyzeButtonStyle}" Margin="0,6,0,0" Click="Analyze_Click" IsEnabled="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}">
                        <TextBlock>
                            <Run Text="{x:Bind ViewModel.IsAnalyzing, Mode=OneWay, Converter={StaticResource AnalyzingTextConverter}}"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Border>
            </Grid>

            <!-- System Health Tab Content -->
            <Frame x:Name="DisplayRecoveryTabContent" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>


