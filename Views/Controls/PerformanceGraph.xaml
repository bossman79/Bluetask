<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Bluetask.Views.Controls.PerformanceGraph"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="240"
    d:DesignWidth="480">
    <Grid x:Name="Root" Background="Transparent">
        <!-- Z-order: grid lines (behind), fill, stroke, axis labels (front) -->
        <Canvas x:Name="GridCanvas" IsHitTestVisible="False"/>
        <Canvas x:Name="FillCanvas" IsHitTestVisible="False"/>
        <Polyline x:Name="StrokePolyline" StrokeThickness="2" Fill="Transparent" Stroke="White" StrokeLineJoin="Round" IsHitTestVisible="False"/>
        <Canvas x:Name="AxisLabelsCanvas" IsHitTestVisible="False"/>
    </Grid>
</UserControl>


