<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Bluetask.Views.DisplayRecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Bluetask.Models"
    xmlns:converters="using:Bluetask.Services.Converters"
    mc:Ignorable="d"
    Background="Transparent"
    RequestedTheme="Dark">

    <Page.Resources>
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>
        
        <Style x:Key="CompactCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource App.CardGradientBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource App.CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        
        <Style x:Key="CompactButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Page.Resources>

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Scan Button Banner -->
        <Button Grid.Row="0"
                Command="{x:Bind ViewModel.ScanForIssuesCommand}"
                Background="#3B82F6"
                Foreground="White"
                BorderThickness="0"
                Padding="0,12"
                CornerRadius="6"
                HorizontalAlignment="Stretch"
                Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="16"/>
                <TextBlock Text="Scan System" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
        </Button>

        <!-- Main Content Grid - Two Columns -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Quick Fix Actions - Left Column -->
            <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CompactCardStyle}" Margin="0,0,5,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="Quick Fix" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                    <Button Command="{x:Bind ViewModel.RestartExplorerCommand}"
                            Background="#10B981" Foreground="White" BorderThickness="0"
                            Padding="10,8" CornerRadius="6" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE777;" FontSize="14"/>
                            <TextBlock Text="Restart Explorer" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{x:Bind ViewModel.RestartDwmCommand}" Style="{StaticResource CompactButtonStyle}">
                            <TextBlock Text="Restart DWM" FontSize="10"/>
                        </Button>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearVramCacheCommand}" Style="{StaticResource CompactButtonStyle}">
                            <TextBlock Text="Clear VRAM" FontSize="10"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- System Health Log - Right Column -->
            <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource CompactCardStyle}" Margin="5,0,0,10">
                <StackPanel Spacing="8">
                    <TextBlock Text="System Health Status" FontSize="12" FontWeight="SemiBold" Opacity="0.8"/>
                    
                    <!-- Status Message -->
                    <Border Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="8,6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" FontSize="12" Foreground="#3B82F6"/>
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" 
                                      FontSize="10" 
                                      TextWrapping="Wrap"
                                      Opacity="0.9"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Health Metrics Grid -->
                    <Grid RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1 -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
                            <TextBlock Text="GPU Driver" FontSize="9" Opacity="0.5"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemStatus.GpuDriverStatus, Mode=OneWay}" 
                                      FontSize="10" FontWeight="SemiBold"
                                      Foreground="{x:Bind ViewModel.SystemStatus.GpuDriverStatusColor, Mode=OneWay}"
                                      TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2">
                            <TextBlock Text="Compositor" FontSize="9" Opacity="0.5"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemStatus.DwmCompositorStatus, Mode=OneWay}" 
                                      FontSize="10" FontWeight="SemiBold"
                                      Foreground="{x:Bind ViewModel.SystemStatus.DwmCompositorColor, Mode=OneWay}"/>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Spacing="2">
                            <TextBlock Text="Display" FontSize="9" Opacity="0.5"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemStatus.DisplaySurfacesStatus, Mode=OneWay}" 
                                      FontSize="10" FontWeight="SemiBold"
                                      Foreground="{x:Bind ViewModel.SystemStatus.DisplaySurfacesColor, Mode=OneWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2">
                            <TextBlock Text="VRAM" FontSize="9" Opacity="0.5"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemStatus.VramUtilizationDisplay, Mode=OneWay}" 
                                      FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Row 3 -->
                        <StackPanel Grid.Column="0" Grid.Row="2" Spacing="2">
                            <TextBlock Text="DXGI Runtime" FontSize="9" Opacity="0.5"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemStatus.DxgiRuntimeStatus, Mode=OneWay}" 
                                      FontSize="10" FontWeight="SemiBold"
                                      Foreground="{x:Bind ViewModel.SystemStatus.DxgiRuntimeColor, Mode=OneWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="2" Spacing="2">
                            <TextBlock Text="Display Conn." FontSize="9" Opacity="0.5"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemStatus.DisplayConnectivity, Mode=OneWay}" 
                                      FontSize="10" FontWeight="SemiBold"
                                      Foreground="{x:Bind ViewModel.SystemStatus.DisplayConnectivityColor, Mode=OneWay}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Scan Results Summary - Bottom Full Width -->
            <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource CompactCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Title with inline stats -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Last Scan Results" FontSize="12" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right">
                            <!-- Display Issues -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.LastScanDisplayIssues, Mode=OneWay}" 
                                          FontSize="12" FontWeight="Bold"
                                          Foreground="{x:Bind ViewModel.DisplayIssuesColor, Mode=OneWay}"/>
                                <TextBlock Text="display" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Frozen Apps -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.UnresponsiveApps.Count, Mode=OneWay}" 
                                          FontSize="12" FontWeight="Bold"
                                          Foreground="{x:Bind ViewModel.FrozenAppsColor, Mode=OneWay}"/>
                                <TextBlock Text="frozen" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- BSOD Risks -->
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.LastScanBsodRisks, Mode=OneWay}" 
                                          FontSize="12" FontWeight="Bold"
                                          Foreground="{x:Bind ViewModel.BsodRisksColor, Mode=OneWay}"/>
                                <TextBlock Text="BSOD risks" FontSize="10" Opacity="0.6" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    
                    <!-- Detailed Findings -->
                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="6" Padding="8" Height="220">
                        <Grid>
                            <!-- Empty state when no findings -->
                            <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{x:Bind ViewModel.HasNoScanFindings, Mode=OneWay}">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE73E;" FontSize="28" Foreground="#10B981" HorizontalAlignment="Center" Opacity="0.5"/>
                                <TextBlock Text="No issues detected during last scan" FontSize="11" Opacity="0.6" TextAlignment="Center"/>
                            </StackPanel>
                            
                            <!-- Findings list with full scroll - Use ListView for virtualization -->
                            <ListView Visibility="{x:Bind ViewModel.HasScanFindings, Mode=OneWay}"
                                     ItemsSource="{x:Bind ViewModel.ScanFindings, Mode=OneWay}"
                                     SelectionMode="None"
                                     IsItemClickEnabled="False"
                                     Background="Transparent"
                                     Padding="0">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,0,0,6"/>
                                            <Setter Property="MinHeight" Value="0"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ScanFinding">
                                            <Border Background="#1A1F2E" 
                                                   BorderBrush="{x:Bind SeverityColor, Mode=OneTime}" 
                                                   BorderThickness="1" 
                                                   CornerRadius="4" 
                                                   Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <TextBlock Grid.Column="0" Text="{x:Bind Icon, Mode=OneTime}" 
                                                              FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Message, Mode=OneTime}" 
                                                              FontSize="10" 
                                                              TextWrapping="Wrap"
                                                              VerticalAlignment="Center"/>
                                                    
                                                    <Border Grid.Column="2" 
                                                           Background="{x:Bind SeverityColor, Mode=OneTime}" 
                                                           CornerRadius="3" 
                                                           Padding="6,2" 
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0">
                                                        <TextBlock Text="{x:Bind Category, Mode=OneTime}" 
                                                                  FontSize="8" 
                                                                  FontWeight="Bold" 
                                                                  Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
